domain: automation

input:
  motion_sensors:
    name: "Датчики движения / Motion sensors"
    description: "Выберите один или несколько binary_sensor с классом occupancy. / Select one or more binary_sensor entities with occupancy class."
    selector:
      entity:
        domain: binary_sensor
        multiple: true

  lights:
    name: "Свет / Lights"
    description: "Целевые light.* или зона, которые будут включаться/выключаться. / Target light entities or area to control."
    selector:
      target:
        entity:
          domain: light

  timer_entity:
    name: "Таймер / Timer entity"
    description: "Выберите timer.* — будет использоваться для отсчёта времени до выключения света. / Choose a timer.* entity to count down before turning lights off."
    selector:
      entity:
        domain: timer

  delay_input_number:
    name: "Input number: время ожидания (мин) / Input number: delay (minutes)"
    description: "Input_number, задающий длительность таймера в минутах. / Input_number that sets timer duration in minutes."
    selector:
      entity:
        domain: input_number

  door_sensor:
    name: "Датчик двери (опционально) / Door sensor (optional)"
    description: "Binary_sensor двери. При открытии свет включается и запускается таймер. Оставьте пустым, если не нужен. / Door binary_sensor. When opened, lights turn on and timer starts. Leave empty if unused."
    selector:
      entity:
        domain: binary_sensor
        multiple: false

  global_conditions:
    name: "Глобальные условия / Global conditions"
    description: "Условия, при которых автоматизация должна выполняться (например: только ночью, только если кто-то дома). / Conditions when automation should run (e.g., only at night, only if someone is home)."
    selector:
      condition: {}

  timer_finished_actions:
    name: "Действия при завершении таймера / Actions on timer finish"
    description: "Дополнительные действия, которые будут выполнены после завершения таймера (опционально). / Additional actions to run after timer finishes (optional)."
    selector:
      action: {}

variables:
  # minutes will be read from the selected input_number entity at runtime
  minutes: "{{ states(input('delay_input_number')) | default('3') | float | int }}"

trigger:
  - platform: state
    entity_id: !input motion_sensors
    to: "on"
    id: motion_detected

  - platform: state
    entity_id: !input motion_sensors
    to: "off"
    id: motion_stopped

  - platform: event
    event_type: timer.finished
    event_data:
      entity_id: !input timer_entity
    id: timer_finished

  - platform: state
    entity_id: !input door_sensor
    to: "on"
    id: door_opened

condition: !input global_conditions

action:
  - choose:
      - conditions:
          - condition: trigger
            id: motion_detected
        sequence:
          - service: light.turn_on
            target: !input lights
          - service: timer.cancel
            target:
              entity_id: !input timer_entity

      - conditions:
          - condition: trigger
            id: motion_stopped
        sequence:
          - service: timer.start
            target:
              entity_id: !input timer_entity
            data:
              duration: >
                {% set m = states(input('delay_input_number')) | default('3') | float | int %}
                {% set hh = (m // 60) %}
                {% set mm = (m % 60) %}
                {{ "%02d:%02d:00" | format(hh, mm) }}

      - conditions:
          - condition: trigger
            id: door_opened
        sequence:
          - service: light.turn_on
            target: !input lights
          - service: timer.start
            target:
              entity_id: !input timer_entity
            data:
              duration: >
                {% set m = states(input('delay_input_number')) | default('3') | float | int %}
                {% set hh = (m // 60) %}
                {% set mm = (m % 60) %}
                {{ "%02d:%02d:00" | format(hh, mm) }}

      - conditions:
          - condition: trigger
            id: timer_finished
        sequence:
          - service: light.turn_off
            target: !input lights
          - choose: []
            default: !input timer_finished_actions

mode: restart
